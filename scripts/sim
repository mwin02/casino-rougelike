#!/usr/bin/env bash
# Runs the simulation harness (spec §12) across several Godot processes and
# prints the merged report. Every flag but -j goes to sim/sim_main.gd (see
# sim/sim_options.gd); the report is the same for any -j.
# Usage: scripts/sim [-j N] [--games=...] [--bots=...] [--sessions=N] [--set=section.key=v,...]
set -uo pipefail
cd "$(dirname "$0")/.."

GODOT_BIN="${GODOT_BIN:-$(command -v godot || true)}"
if [ -z "$GODOT_BIN" ] || [ ! -x "$GODOT_BIN" ]; then
	echo "scripts/sim: Godot binary not found. Set GODOT_BIN." >&2
	exit 1
fi

jobs="$(sysctl -n hw.ncpu 2>/dev/null || nproc)"
args=()
while [ $# -gt 0 ]; do
	case "$1" in
		-j) jobs="$2"; shift 2 ;;
		-j*) jobs="${1#-j}"; shift ;;
		*) args+=("$1"); shift ;;
	esac
done

"$GODOT_BIN" --headless --path . --import >/dev/null 2>&1
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT

pids=()
for ((i = 0; i < jobs; i++)); do
	"$GODOT_BIN" --headless --path . -s res://sim/sim_main.gd -- \
		"${args[@]+"${args[@]}"}" "--shard=$i/$jobs" "--out=$out/shard_$i.json" \
		>"$out/log_$i.txt" 2>&1 &
	pids+=("$!")
done
failed=()
for i in "${!pids[@]}"; do
	wait "${pids[$i]}" || failed+=("$i")
done
if [ "${#failed[@]}" -gt 0 ]; then
	# Every shard reads the same flags, so the first failure speaks for all.
	echo "scripts/sim: ${#failed[@]} of $jobs shards failed; shard ${failed[0]}:" >&2
	grep -E "sim:|ERROR" "$out/log_${failed[0]}.txt" >&2
	exit 1
fi

"$GODOT_BIN" --headless --path . -s res://sim/sim_merge.gd -- "$out"/shard_*.json 2>&1 \
	| grep -vE "^Godot Engine|^$"
